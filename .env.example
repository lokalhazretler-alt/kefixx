# Discord Developer Portal (https://discord.com/developers/applications) adresinden
# uygulamanı oluştur, "OAuth2 > General" sekmesinden Client ID ve Client Secret'ı al.
DISCORD_CLIENT_ID=uygulama-client-id
DISCORD_CLIENT_SECRET=uygulama-client-secret

# Discord Developer Portal > OAuth2 > Redirects kısmına BİREBİR aynısını ekle.
# Yerelde test için: http://localhost:3000/api/auth/discord/callback
# Canlıda: https://siteniz.com/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Oturum çerezini imzalamak için rastgele, uzun ve gizli bir değer.
# Üretmek için: openssl rand -hex 32
SESSION_SECRET=rastgele-uzun-gizli-bir-deger
